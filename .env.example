# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # /start prints it; bot ignores everyone else
TELEGRAM_WEBHOOK_SECRET=     # any random string

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore        # French voice
GEMINI_TTS_VOICE_EN=Puck     # English prompts inside drills

# Postgres (Neon connection string with sslmode=require; Supabase/local also work)
DATABASE_URL=

# Secret for /api/setup and the cron endpoints (?key=... or x-cron-key header)
CRON_SECRET=

# Learner
LEARNER_TZ=America/Toronto
STUDY_START_DATE=2026-09-07
TARGET_EXAM_DATE=2027-05-01
